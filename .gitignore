# Per-package build artifacts (e.g. Mix _build/deps, assets) are ignored by
# each package's own .gitignore (see livedata/.gitignore). Keep only
# repo-wide entries here.

.hall-cache/
.claude
.mcp.json

# devenv
.devenv*
devenv.local.nix
.direnv

# deploy secrets — copy from deploy/.env.example, never commit
deploy/.env

# Terraform local state and provider cache (bootstrap uses local state by design)
terraform/bootstrap/terraform.tfstate
terraform/bootstrap/terraform.tfstate.backup
**/.terraform/
